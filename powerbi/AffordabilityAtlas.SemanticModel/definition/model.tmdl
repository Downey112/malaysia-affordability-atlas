model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProcessedFolder", "dim_state", "dim_basket", "dim_income_position", "dim_household_type", "dim_spending_group", "mart_burden", "mart_counterfactual", "mart_decomposition", "mart_budget_gap", "mart_pli", "mart_pressure", "mart_real_income", "mart_real_wages", "fact_state_year", "fact_district_year", "fact_spending_state", "fact_basket_state"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_state
ref table dim_basket
ref table dim_income_position
ref table dim_household_type
ref table dim_spending_group
ref table mart_burden
ref table mart_counterfactual
ref table mart_decomposition
ref table mart_budget_gap
ref table mart_pli
ref table mart_pressure
ref table mart_real_income
ref table mart_real_wages
ref table fact_state_year
ref table fact_district_year
ref table fact_spending_state
ref table fact_basket_state
ref table Purchases
ref table AtlasMeasures

ref cultureInfo en-US
