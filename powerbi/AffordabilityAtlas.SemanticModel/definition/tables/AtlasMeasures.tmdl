	measure 'Pressure Signals Label' =
			VAR sig = SELECTEDVALUE ( mart_pressure[pressure_signals] )
			VAR avail = SELECTEDVALUE ( mart_pressure[signals_available] )
			RETURN
			    IF ( NOT ISBLANK ( sig ), sig & " of " & avail )
		displayFolder: Pressure
		lineageTag: 8ed11b43-c22b-52be-9516-fcf2bcd94911

	measure 'Selection Label' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
			VAR basket =
			    SWITCH (
			        b,
			        "core", "Core 7",
			        "staples_16", "Staples 16",
			        "Staples + rice"
			    )
			RETURN
			    basket & " · P" & p & " · " & q & " purchases a month"
		displayFolder: Titles
		lineageTag: 6ed5d214-1daa-51a6-9664-4cf6eda7cf75

	measure 'Budget % Households Below' =
			VAR h = SELECTEDVALUE ( dim_household_type[household_type], "Married (2 Children)" )
			RETURN
			    CALCULATE (
			        AVERAGE ( mart_budget_gap[pct_households_below] ),
			        REMOVEFILTERS ( dim_household_type ),
			        mart_budget_gap[household_type] = h
			    )
		formatString: 0\%
		displayFolder: Budgets
		lineageTag: 3cbc590d-b26b-57df-9e8b-836f76c5aa49

