	measure 'Monthly Basket Spend (RM)' = SELECTEDVALUE ( Purchases[n], 4 ) * [Basket Cost 2024 (RM)]
		formatString: \R\M#,0.00
		displayFolder: Base
		lineageTag: 3709f2bd-dc3a-530a-9f6f-e6d92550e8da

	measure 'Highest Burden State' =
			VAR States =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_state[state] ), "@Burden", [Burden %] ),
			        NOT ISBLANK ( [@Burden] )
			    )
			RETURN
			    MAXX ( TOPN ( 1, States, [@Burden], DESC ), dim_state[state] )
		displayFolder: Ranking
		lineageTag: 01ccf78b-f128-50b8-a8dc-fea8ca3220c1

	measure 'Highest Burden Value' =
			VAR States =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_state[state] ), "@Burden", [Burden %] ),
			        NOT ISBLANK ( [@Burden] )
			    )
			RETURN
			    MAXX ( States, [@Burden] )
		formatString: 0.0\%
		displayFolder: Ranking
		lineageTag: e35c7586-090e-5fad-a3f9-25feecbfb8c3

	measure 'Lowest Burden State' =
			VAR States =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_state[state] ), "@Burden", [Burden %] ),
			        NOT ISBLANK ( [@Burden] )
			    )
			RETURN
			    MINX ( TOPN ( 1, States, [@Burden], ASC ), dim_state[state] )
		displayFolder: Ranking
		lineageTag: 15cfae82-937c-5f64-9930-7a5ecebeb3c0

	measure 'Lowest Burden Value' =
