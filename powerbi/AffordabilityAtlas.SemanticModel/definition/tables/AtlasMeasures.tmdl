	measure 'Burden Gap (x)' = DIVIDE ( [Highest Burden Value], [Lowest Burden Value] )
		formatString: 0.00\x
		displayFolder: Ranking
		lineageTag: dabd9d9d-0f1b-5286-af13-f1c25f997cdf

	measure 'Price Share of Gap %' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
			RETURN
			    CALCULATE (
			        AVERAGE ( mart_decomposition[share_due_to_price_pct] ),
			        REMOVEFILTERS ( dim_basket ),
			        REMOVEFILTERS ( dim_income_position ),
			        mart_decomposition[basket_id] = b,
			        mart_decomposition[percentile] = p
			    )
		formatString: +0.0\%;-0.0\%;0.0\%
		displayFolder: Decomposition
		lineageTag: 2e8a3432-3585-5306-9cc9-6c4901e74d38

	measure 'Income Share of Gap %' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
			RETURN
			    CALCULATE (
			        AVERAGE ( mart_decomposition[share_due_to_income_pct] ),
			        REMOVEFILTERS ( dim_basket ),
			        REMOVEFILTERS ( dim_income_position ),
			        mart_decomposition[basket_id] = b,
