		lineageTag: 2c1aa00e-7362-5624-9d40-b7bb942f8b6a

	measure 'Burden with Typical Price %' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
			VAR stored =
			    CALCULATE (
			        AVERAGE ( mart_counterfactual[typical_price_burden_pct] ),
			        REMOVEFILTERS ( dim_basket ),
			        REMOVEFILTERS ( dim_income_position ),
			        mart_counterfactual[basket_id] = b,
			        mart_counterfactual[percentile] = p
			    )
			RETURN
			    IF ( NOT ISBLANK ( stored ), stored * q / 4 )
		formatString: 0.0\%
		displayFolder: Counterfactual
		lineageTag: d8084dde-97b5-5fc8-9634-072368a94fde

	measure 'Burden with Malaysia Income %' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
			VAR stored =
			    CALCULATE (
			        AVERAGE ( mart_counterfactual[mys_income_burden_pct] ),
			        REMOVEFILTERS ( dim_basket ),
			        REMOVEFILTERS ( dim_income_position ),
			        mart_counterfactual[basket_id] = b,
			        mart_counterfactual[percentile] = p
