		formatString: \R\M#,0.00
		displayFolder: Base
		lineageTag: 7c910e37-7755-5d39-a5ee-077927a0d29a

	measure 'Income at Position (RM)' =
			VAR q = SELECTEDVALUE ( Purchases[n], 4 )
			VAR b = SELECTEDVALUE ( dim_basket[basket_id], "staples_plus_rice" )
			VAR p = SELECTEDVALUE ( dim_income_position[percentile], 10 )
