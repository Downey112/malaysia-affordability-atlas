{
  "name": "AffordabilityAtlas",
  "dataColors": [
    "#0F4C5C",
    "#7FA9AF",
    "#E3A857",
    "#C8553D",
    "#5F6B76",
    "#1F2933"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#0F4C5C",
  "good": "#16A34A",
  "neutral": "#5F6B76",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6B76"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FBF6EE"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FBF6EE"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6B76"
              }
            },
            "fontSize": 8.5
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6B76"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6B76"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 8.5
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EADFCF"
              }
            },
            "gridVertical": false,
            "rowPadding": 2
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6B76"
              }
            },
            "fontSize": 9,
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6B76"
              }
            },
            "fontSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 9.5
          }
        ]
      }
    }
  }
}
